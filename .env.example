# Copier en .env.local et compléter. Ne jamais committer .env.local.
# Attention : pointer le développement local sur une base distincte de la production.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement (64 caractères hexadécimaux) : mots de passe de messagerie des
# clients et clés des fournisseurs IA. La changer rend les valeurs existantes
# illisibles. Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=

# File d'envoi des e-mails commune (table mail_sortant, AlwaysData)
MAIL_DATABASE_URL=

# Adresse publique du site (liens dans les e-mails)
APP_URL=https://unitech-qvgo.onrender.com

# Secret des tâches planifiées (/api/dona/trigger, /api/harvey/trigger)
CRON_SECRET=

# Clés IA de secours (les clés gérées depuis l'admin, table api_keys, priment)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
